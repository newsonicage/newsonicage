# ══════════════════════════════════════════════
# NEWSONIC AGE — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════

# ── Google OAuth Credentials ──────────────────
# Get these from: console.cloud.google.com
#   → Create Project → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Google Refresh Token ──────────────────────
# One-time setup: run the server locally, visit /auth/google, complete OAuth,
# then copy the refresh_token printed to the console into this variable.
# Once set, the server connects to Calendar on startup — no OAuth flow needed.
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ── OAuth Callback URL ────────────────────────
# Must match exactly what you set in Google Cloud Console
# For local dev: http://localhost:3000/auth/google/callback
# For production: https://yourdomain.com/auth/google/callback
REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Calendar Settings ─────────────────────────
# CALENDAR_ID: Use 'primary' for your main calendar,
# or a specific calendar ID (find it in Google Calendar Settings)
CALENDAR_ID=primary

# TIMEZONE: IANA timezone string for your business location
# Examples: America/New_York | America/Los_Angeles | America/Chicago
#           Europe/London | Europe/Paris | Asia/Tokyo
TIMEZONE=America/New_York

# ── Email Notifications ───────────────────────
# GMAIL_USER: your Gmail address
# GMAIL_APP_PASSWORD: 16-char App Password (myaccount.google.com → Security → App passwords)
GMAIL_USER=your_gmail_here@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── Frontend API Base URL ─────────────────────
# Controls which backend the booking page calls.
#
# Local dev  → leave blank (empty string) so fetch('/availability') hits the
#              same Express server that serves the HTML — no cross-origin needed.
#
# Production → set to your Render backend URL (no trailing slash):
#              API_BASE_URL=https://newsonicage-backend.onrender.com
#
# To switch environments: update this value and restart the server.
# The browser receives it via GET /config.js as window.API_BASE_URL.
API_BASE_URL=

# ── Server ────────────────────────────────────
PORT=3000

# ── Twilio SMS follow-up (Netlify only) ───────
# These are NOT read by server.js. They are read by the Netlify function
# netlify/functions/submission-created.js, which texts a lead after they tick
# the optional consent box on the intake form.
#
# Set them in Netlify → Site configuration → Environment variables, NOT here.
# Until all four exist the function runs, logs, and sends nothing — and it names
# the missing ones in the log, so read the log before comparing values by eye.
#
# Auth is a SCOPED API KEY, not the account auth token. The key SID and secret are
# the basic-auth pair; the ACCOUNT SID is still required separately because it goes
# in the request URL path. Create the key at Twilio Console → Account → API keys &
# tokens. The secret is shown exactly ONCE at creation — if it is lost, delete the
# key and make a new one. Never park it in a repo file (see the scanner note below).
#
# Use the Messaging Service SID (not a bare phone number) — the A2P campaign is
# bound to the service, and sending from a raw From number can get traffic filtered.
#
# PLACEHOLDERS ONLY. Do not paste the real values here. These are marked "Contains
# secret values" in Netlify, and Netlify's secrets scanner fails the build if it
# finds a secret env var's value anywhere in the repo — which is exactly what
# happened when the real Messaging Service SID was written here.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
